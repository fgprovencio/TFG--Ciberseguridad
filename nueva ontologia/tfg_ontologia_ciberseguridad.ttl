<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/actor_can_exploit
:actor_can_exploit rdf:type owl:ObjectProperty ;
                   rdfs:domain :Threat_Actor ;
                   rdfs:range :Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/actor_deploys_malware
:actor_deploys_malware rdf:type owl:ObjectProperty ;
                       rdfs:domain :Threat_Actor ;
                       rdfs:range :Malware .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/actor_targets_identity
:actor_targets_identity rdf:type owl:ObjectProperty ;
                        rdfs:domain :Threat_Actor ;
                        rdfs:range :Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/actor_uses_technique
:actor_uses_technique rdf:type owl:ObjectProperty ;
                      owl:inverseOf :technique_uses_actor ;
                      rdfs:domain :Threat_Actor ;
                      rdfs:range :Attack_Technique .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/attack_pattern_targets_weakness
:attack_pattern_targets_weakness rdf:type owl:ObjectProperty ;
                                 rdfs:domain :Attack_Pattern ;
                                 rdfs:range :Weakness .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/course_of_action_mitigates_vulnerability
:course_of_action_mitigates_vulnerability rdf:type owl:ObjectProperty ;
                                          owl:inverseOf :vulnerability_mitigated_course_of_action ;
                                          rdfs:domain :Course_of_Action ;
                                          rdfs:range :Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/malware_exploits_vulnerability
:malware_exploits_vulnerability rdf:type owl:ObjectProperty ;
                                rdfs:domain :Malware ;
                                rdfs:range :Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/malware_uses_technique
:malware_uses_technique rdf:type owl:ObjectProperty ;
                        rdfs:domain :Malware ;
                        rdfs:range :Attack_Technique .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/technique_implemented_by_pattern
:technique_implemented_by_pattern rdf:type owl:ObjectProperty ;
                                  rdfs:domain :Attack_Technique ;
                                  rdfs:range :Attack_Pattern .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/technique_targets_identity
:technique_targets_identity rdf:type owl:ObjectProperty ;
                            rdfs:domain :Attack_Technique ;
                            rdfs:range :Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/technique_uses_actor
:technique_uses_actor rdf:type owl:ObjectProperty ;
                      rdfs:domain :Attack_Technique ;
                      rdfs:range :Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/vulnerability_affects_software
:vulnerability_affects_software rdf:type owl:ObjectProperty ;
                                rdfs:domain :Vulnerability ;
                                rdfs:range :Software_Asset .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/vulnerability_classified_by_weakness
:vulnerability_classified_by_weakness rdf:type owl:ObjectProperty ;
                                      rdfs:domain :Vulnerability ;
                                      rdfs:range :Weakness .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/vulnerability_found_in_identity
:vulnerability_found_in_identity rdf:type owl:ObjectProperty ;
                                 rdfs:domain :Vulnerability ;
                                 rdfs:range :Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad/vulnerability_mitigated_course_of_action
:vulnerability_mitigated_course_of_action rdf:type owl:ObjectProperty ;
                                          rdfs:domain :Vulnerability ;
                                          rdfs:range :Course_of_Action .


