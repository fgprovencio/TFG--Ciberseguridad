        <tfg_ontologia_ciberseguridad:hasDescription>The account file upload functionality in Syspass 3.2.x fails to properly handle special characters in filenames. This mismanagement leads to the disclosure of the web application s source code, exposing sensitive information such as the database password.</tfg_ontologia_ciberseguridad:hasDescription>
    </owl:NamedIndividual>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-26058 -->

    <owl:NamedIndividual rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-26058">
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Medium_Risk_Vulnerability"/>
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <tfg_ontologia_ciberseguridad:vulnerability_classified_by_weakness rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CWE-598"/>
        <tfg_ontologia_ciberseguridad:hasCVEID>CVE-2025-26058</tfg_ontologia_ciberseguridad:hasCVEID>
        <tfg_ontologia_ciberseguridad:hasCVSSScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">4.2</tfg_ontologia_ciberseguridad:hasCVSSScore>
        <tfg_ontologia_ciberseguridad:hasDescription>Webkul QloApps v1.6.1 exposes authentication tokens in URLs during redirection. When users access the admin panel or other protected areas, the application appends sensitive authentication tokens directly to the URL.</tfg_ontologia_ciberseguridad:hasDescription>
    </owl:NamedIndividual>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-26605 -->

    <owl:NamedIndividual rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-26605">
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#High_Risk_Vulnerability"/>
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigated_Vulnerability"/>
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <tfg_ontologia_ciberseguridad:vulnerability_classified_by_weakness rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CWE-89"/>
        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigation_T1046_NetworkServiceScanningMitigation"/>
        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#NetworkServiceScanningMitigation"/>
        <tfg_ontologia_ciberseguridad:hasCVEID>CVE-2025-26605</tfg_ontologia_ciberseguridad:hasCVEID>
        <tfg_ontologia_ciberseguridad:hasCVSSScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">8.8</tfg_ontologia_ciberseguridad:hasCVSSScore>
        <tfg_ontologia_ciberseguridad:hasDescription>WeGIA is an open source Web Manager for Institutions with a focus on Portuguese language users. A SQL Injection vulnerability was discovered in the WeGIA application, `deletar_cargo.php` endpoint. This vulnerability could allow an authorized attacker to execute arbitrary SQL queries, allowing access to sensitive information. This issue has been addressed in version 3.2.13 and all users are advised to upgrade. There are no known workarounds for this vulnerability.</tfg_ontologia_ciberseguridad:hasDescription>
    </owl:NamedIndividual>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-26606 -->

    <owl:NamedIndividual rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-26606">
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Critical_Vulnerability"/>
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigated_Vulnerability"/>
        <rdf:type rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <tfg_ontologia_ciberseguridad:vulnerability_classified_by_weakness rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CWE-89"/>
        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigation_T1046_NetworkServiceScanningMitigation"/>
