        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#boolean"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#publishedDate -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#publishedDate">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    </owl:DatatypeProperty>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Classes
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Pattern -->

    <owl:Class rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Pattern">
        <rdfs:subClassOf>
