    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_classified_by_weakness -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_classified_by_weakness">
        <owl:inverseOf rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#weakness_classifies_vulnerability"/>
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Weakness"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_found_in_identity -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_found_in_identity">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Identity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_mitigated_course_of_action -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_mitigated_course_of_action">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Course_of_Action"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#weakness_classifies_vulnerability -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#weakness_classifies_vulnerability">
