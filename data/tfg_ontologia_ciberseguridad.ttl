        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#FileAndDirectoryDiscoveryMitigation"/>
        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#GeneralSecurityHardening"/>
