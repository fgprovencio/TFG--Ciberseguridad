     -->

    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasAbstractionLevel -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasAbstractionLevel">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Pattern"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasActorName -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasActorName">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCVEID -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCVEID">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCVSSScore -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCVSSScore">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#FunctionalProperty"/>
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#decimal"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCapecID -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCapecID">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Pattern"/>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasDescription -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasDescription">
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    </owl:DatatypeProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasMotivation -->

    <owl:DatatypeProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasMotivation">
