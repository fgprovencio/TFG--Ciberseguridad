        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigation_T1574.007_GeneralSecurityHardening"/>
        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#NetworkServiceScanningMitigation"/>
