        <tfg_ontologia_ciberseguridad:hasCVSSScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.1</tfg_ontologia_ciberseguridad:hasCVSSScore>
        <tfg_ontologia_ciberseguridad:hasDescription>IBM Maximo Application Suite 9.0.0 - Monitor Component is vulnerable to cross-site scripting. This vulnerability allows an unauthenticated attacker to embed arbitrary JavaScript code in the Web UI thus altering the intended functionality potentially leading to credentials disclosure within a trusted session.</tfg_ontologia_ciberseguridad:hasDescription>
    </owl:NamedIndividual>
    


