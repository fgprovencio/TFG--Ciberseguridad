<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.semanticweb.org/paki1/ontologies/2026/4/untitled-ontology-92#"
     xml:base="http://www.semanticweb.org/paki1/ontologies/2026/4/untitled-ontology-92"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:swrl="http://www.w3.org/2003/11/swrl#"
     xmlns:swrla="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#"
     xmlns:swrlb="http://www.w3.org/2003/11/swrlb#"
     xmlns:tfg_ontologia_ciberseguridad="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#">
    <owl:Ontology rdf:about="http://www.semanticweb.org/paki1/ontologies/2026/4/untitled-ontology-92"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled -->

    <owl:AnnotationProperty rdf:about="http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->

    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_can_exploit -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_can_exploit">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_uses_technique"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_implemented_by_pattern"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#attack_pattern_targets_weakness"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_classified_by_weakness"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_deploys_malware -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_deploys_malware">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Malware"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_targets_identity -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_targets_identity">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Identity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_uses_technique -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_uses_technique">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#attack_pattern_targets_weakness -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#attack_pattern_targets_weakness">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Pattern"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Weakness"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#course_of_action_mitigates_vulnerability -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#course_of_action_mitigates_vulnerability">
        <owl:inverseOf rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_mitigated_course_of_action"/>
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Course_of_Action"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasWeaknessCategory -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasWeaknessCategory">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Weakness"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CWE_Category"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#malware_exploits_vulnerability -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#malware_exploits_vulnerability">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Malware"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#malware_uses_technique"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_implemented_by_pattern"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#attack_pattern_targets_weakness"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#weakness_classifies_vulnerability"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#malware_uses_technique -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#malware_uses_technique">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Malware"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_deploys_malware"/>
            </rdf:Description>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_uses_technique"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_compromises_vulnerability -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_compromises_vulnerability">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Software"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_uses_technique"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_implemented_by_pattern"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#attack_pattern_targets_weakness"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#weakness_classifies_vulnerability"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_is_used_by_actor -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_is_used_by_actor">
        <owl:inverseOf rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#uses_software"/>
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Software"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_uses_technique -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_uses_technique">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Software"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_is_used_by_actor"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_uses_technique"/>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_implemented_by_pattern -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_implemented_by_pattern">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Pattern"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_targets_identity -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_targets_identity">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Identity"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_targets_vulnerability -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_targets_vulnerability">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_implemented_by_pattern"/>
            <rdf:Description rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#attack_pattern_targets_weakness"/>
            <rdf:Description>
                <owl:inverseOf rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_classified_by_weakness"/>
            </rdf:Description>
        </owl:propertyChainAxiom>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_uses_actor -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_uses_actor">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique"/>
        <rdfs:range rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#uses_software -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#uses_software">
        <rdfs:domain rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor"/>
    </owl:ObjectProperty>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_affects_software -->

    <owl:ObjectProperty rdf:about="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_affects_software">
