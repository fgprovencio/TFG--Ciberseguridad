        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#NetworkServiceScanningMitigation"/>
        <tfg_ontologia_ciberseguridad:hasCVEID>CVE-2025-1662</tfg_ontologia_ciberseguridad:hasCVEID>
        <tfg_ontologia_ciberseguridad:hasCVSSScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">6.4</tfg_ontologia_ciberseguridad:hasCVSSScore>
        <tfg_ontologia_ciberseguridad:hasDescription>The URL Media Uploader plugin for WordPress is vulnerable to Server-Side Request Forgery in all versions up to, and including, 1.0.0 via the &apos;url_media_uploader_url_upload&apos; action. This makes it possible for authenticated attackers, with author-level access and above, to make web requests to arbitrary locations originating from the web application and can be used to query and modify information from internal services.</tfg_ontologia_ciberseguridad:hasDescription>
    </owl:NamedIndividual>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-1888 -->

