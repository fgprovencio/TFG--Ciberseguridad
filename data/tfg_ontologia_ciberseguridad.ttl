        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigation_T1546.016_GeneralSecurityHardening"/>
        <tfg_ontologia_ciberseguridad:vulnerability_mitigated_course_of_action rdf:resource="http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigation_T1547.006_GeneralSecurityHardening"/>
