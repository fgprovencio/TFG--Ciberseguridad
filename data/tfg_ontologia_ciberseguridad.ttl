        <tfg_ontologia_ciberseguridad:hasCVEID>CVE-2025-27515</tfg_ontologia_ciberseguridad:hasCVEID>
        <tfg_ontologia_ciberseguridad:hasCVSSScore rdf:datatype="http://www.w3.org/2001/XMLSchema#decimal">9.8</tfg_ontologia_ciberseguridad:hasCVSSScore>
        <tfg_ontologia_ciberseguridad:hasDescription>Laravel is a web application framework. When using wildcard validation to validate a given file or image field (`files.*`), a user-crafted malicious request could potentially bypass the validation rules. This vulnerability is fixed in 11.44.1 and 12.1.1.</tfg_ontologia_ciberseguridad:hasDescription>
    </owl:NamedIndividual>
    


    <!-- http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-27518 -->

