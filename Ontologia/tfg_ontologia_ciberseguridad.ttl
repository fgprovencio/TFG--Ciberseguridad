###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-2494
sec:CVE-2025-2494 rdf:type owl:NamedIndividual ,
                           sec:Vulnerability ;
                  sec:vulnerability_classified_by_weakness sec:CWE-434 ;
                  sec:hasCVEID "CVE-2025-2494" ;
                  sec:hasCVSSScore 9.8 ;
                  sec:hasDescription "Unrestricted file upload to Softdial Contact Center of Sytel Ltd. This vulnerability could allow an attacker to upload files to the server via the ‘/softdial/phpconsole/upload.php’ endpoint, which is protected by basic HTTP authentication. The files are uploaded to a directory exposed by the web application, which could result in code execution, giving the attacker full control over the server." .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-24957
sec:CVE-2025-24957 rdf:type owl:NamedIndividual ,
