###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CVE-2025-26615
sec:CVE-2025-26615 rdf:type owl:NamedIndividual ,
                            sec:Vulnerability ;
                   sec:vulnerability_classified_by_weakness sec:CWE-22 ;
                   sec:hasCVEID "CVE-2025-26615" ;
                   sec:hasCVSSScore 10.0 ;
                   sec:hasDescription "WeGIA is an open source Web Manager for Institutions with a focus on Portuguese language users. A Path Traversal vulnerability was discovered in the WeGIA application, `examples.php` endpoint. This vulnerability could allow an attacker to gain unauthorized access to sensitive information stored in `config.php`. `config.php` contains information that could allow direct access to the database. This issue has been addressed in version 3.2.14 and all users are advised to upgrade. There are no known workarounds for this vulnerability." .


