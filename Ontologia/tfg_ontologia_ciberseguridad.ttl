@prefix : <http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix sec: <http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#> .

<http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad> rdf:type owl:Ontology .

#################################################################
#    Annotation properties
#################################################################

###  http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled
<http://swrl.stanford.edu/ontologies/3.3/swrla.owl#isRuleEnabled> rdf:type owl:AnnotationProperty .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#uses_software
sec:uses_software rdf:type owl:AnnotationProperty ;
                  rdfs:range sec:Software .


#################################################################
#    Object Properties
#################################################################

###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_can_exploit
sec:actor_can_exploit rdf:type owl:ObjectProperty ;
                      rdfs:domain sec:Threat_Actor ;
                      rdfs:range sec:Vulnerability ;
                      owl:propertyChainAxiom ( sec:actor_uses_technique
                                               sec:technique_implemented_by_pattern
                                               sec:attack_pattern_targets_weakness
                                               [ owl:inverseOf sec:vulnerability_classified_by_weakness
                                               ]
                                             ) .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_deploys_malware
sec:actor_deploys_malware rdf:type owl:ObjectProperty ;
                          rdfs:domain sec:Threat_Actor ;
                          rdfs:range sec:Malware .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_targets_identity
sec:actor_targets_identity rdf:type owl:ObjectProperty ;
                           rdfs:domain sec:Threat_Actor ;
                           rdfs:range sec:Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#actor_uses_technique
sec:actor_uses_technique rdf:type owl:ObjectProperty ;
                         rdfs:domain sec:Threat_Actor ;
                         rdfs:range sec:Attack_Technique .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#attack_pattern_targets_weakness
sec:attack_pattern_targets_weakness rdf:type owl:ObjectProperty ;
                                    rdfs:domain sec:Attack_Pattern ;
                                    rdfs:range sec:Weakness .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#course_of_action_mitigates_vulnerability
sec:course_of_action_mitigates_vulnerability rdf:type owl:ObjectProperty ;
                                             owl:inverseOf sec:vulnerability_mitigated_course_of_action ;
                                             rdfs:domain sec:Course_of_Action ;
                                             rdfs:range sec:Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasWeaknessCategory
sec:hasWeaknessCategory rdf:type owl:ObjectProperty ;
                        rdfs:domain sec:Weakness ;
                        rdfs:range sec:CWE_Category .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#malware_exploits_vulnerability
sec:malware_exploits_vulnerability rdf:type owl:ObjectProperty ;
                                   rdfs:domain sec:Malware ;
                                   rdfs:range sec:Vulnerability ;
                                   owl:propertyChainAxiom ( sec:malware_uses_technique
                                                            sec:technique_implemented_by_pattern
                                                            sec:attack_pattern_targets_weakness
                                                            sec:weakness_classifies_vulnerability
                                                          ) .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#malware_uses_technique
sec:malware_uses_technique rdf:type owl:ObjectProperty ;
                           rdfs:domain sec:Malware ;
                           rdfs:range sec:Attack_Technique ;
                           owl:propertyChainAxiom ( [ owl:inverseOf sec:actor_deploys_malware
                                                    ]
                                                    sec:actor_uses_technique
                                                  ) .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_compromises_vulnerability
sec:software_compromises_vulnerability rdf:type owl:ObjectProperty ;
                                       rdfs:domain sec:Software ;
                                       rdfs:range sec:Vulnerability ;
                                       owl:propertyChainAxiom ( sec:software_uses_technique
                                                                sec:technique_implemented_by_pattern
                                                                sec:attack_pattern_targets_weakness
                                                                sec:weakness_classifies_vulnerability
                                                              ) .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_is_used_by_actor
sec:software_is_used_by_actor rdf:type owl:ObjectProperty ;
                              owl:inverseOf sec:uses_software ;
                              rdfs:domain sec:Software ;
                              rdfs:range sec:Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#software_uses_technique
sec:software_uses_technique rdf:type owl:ObjectProperty ;
                            rdfs:domain sec:Software ;
                            rdfs:range sec:Attack_Technique ;
                            owl:propertyChainAxiom ( sec:software_is_used_by_actor
                                                     sec:actor_uses_technique
                                                   ) .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_implemented_by_pattern
sec:technique_implemented_by_pattern rdf:type owl:ObjectProperty ;
                                     rdfs:domain sec:Attack_Technique ;
                                     rdfs:range sec:Attack_Pattern .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_targets_identity
sec:technique_targets_identity rdf:type owl:ObjectProperty ;
                               rdfs:domain sec:Attack_Technique ;
                               rdfs:range sec:Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_targets_vulnerability
sec:technique_targets_vulnerability rdf:type owl:ObjectProperty ;
                                    rdfs:domain sec:Attack_Technique ;
                                    rdfs:range sec:Vulnerability ;
                                    owl:propertyChainAxiom ( sec:technique_implemented_by_pattern
                                                             sec:attack_pattern_targets_weakness
                                                             [ owl:inverseOf sec:vulnerability_classified_by_weakness
                                                             ]
                                                           ) .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#technique_uses_actor
sec:technique_uses_actor rdf:type owl:ObjectProperty ;
                         rdfs:domain sec:Attack_Technique ;
                         rdfs:range sec:Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#uses_software
sec:uses_software rdf:type owl:ObjectProperty ;
                  rdfs:domain sec:Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_affects_software
sec:vulnerability_affects_software rdf:type owl:ObjectProperty ;
                                   rdfs:domain sec:Vulnerability ;
                                   rdfs:range sec:Software_Asset .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_classified_by_weakness
sec:vulnerability_classified_by_weakness rdf:type owl:ObjectProperty ;
                                         owl:inverseOf sec:weakness_classifies_vulnerability ;
                                         rdfs:domain sec:Vulnerability ;
                                         rdfs:range sec:Weakness .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_found_in_identity
sec:vulnerability_found_in_identity rdf:type owl:ObjectProperty ;
                                    rdfs:domain sec:Vulnerability ;
                                    rdfs:range sec:Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#vulnerability_mitigated_course_of_action
sec:vulnerability_mitigated_course_of_action rdf:type owl:ObjectProperty ;
                                             rdfs:domain sec:Vulnerability ;
                                             rdfs:range sec:Course_of_Action .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#weakness_classifies_vulnerability
sec:weakness_classifies_vulnerability rdf:type owl:ObjectProperty ;
                                      rdfs:domain sec:Weakness ;
                                      rdfs:range sec:Vulnerability .


#################################################################
#    Data properties
#################################################################

###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasAbstractionLevel
sec:hasAbstractionLevel rdf:type owl:DatatypeProperty ;
                        rdfs:domain sec:Attack_Pattern ;
                        rdfs:range xsd:string .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasActorName
sec:hasActorName rdf:type owl:DatatypeProperty ;
                 rdfs:domain sec:Threat_Actor ;
                 rdfs:range xsd:string .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCVEID
sec:hasCVEID rdf:type owl:DatatypeProperty ,
                      owl:FunctionalProperty ;
             rdfs:domain sec:Vulnerability ;
             rdfs:range xsd:string .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCVSSScore
sec:hasCVSSScore rdf:type owl:DatatypeProperty ,
                          owl:FunctionalProperty ;
                 rdfs:domain sec:Vulnerability ;
                 rdfs:range xsd:decimal .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasCapecID
sec:hasCapecID rdf:type owl:DatatypeProperty ;
               rdfs:domain sec:Attack_Pattern ;
               rdfs:range xsd:string .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasDescription
sec:hasDescription rdf:type owl:DatatypeProperty ;
                   rdfs:range xsd:string .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasMotivation
sec:hasMotivation rdf:type owl:DatatypeProperty ;
                  rdfs:domain sec:Threat_Actor ;
                  rdfs:range xsd:string .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#hasTechID
sec:hasTechID rdf:type owl:DatatypeProperty ;
              rdfs:domain sec:Attack_Technique ;
              rdfs:range xsd:string .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#isDetectionPossible
sec:isDetectionPossible rdf:type owl:DatatypeProperty ;
                        rdfs:domain sec:Attack_Technique ;
                        rdfs:range xsd:boolean .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#publishedDate
sec:publishedDate rdf:type owl:DatatypeProperty ;
                  rdfs:domain sec:Vulnerability ;
                  rdfs:range xsd:dateTime .


#################################################################
#    Classes
#################################################################

###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Pattern
sec:Attack_Pattern rdf:type owl:Class ;
                   rdfs:subClassOf [ rdf:type owl:Restriction ;
                                     owl:onProperty sec:attack_pattern_targets_weakness ;
                                     owl:someValuesFrom sec:Weakness
                                   ] .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Attack_Technique
sec:Attack_Technique rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#CWE_Category
sec:CWE_Category rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Cities
sec:Cities rdf:type owl:Class ;
           rdfs:subClassOf sec:Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Course_of_Action
sec:Course_of_Action rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Critical_Infrastructure
sec:Critical_Infrastructure rdf:type owl:Class ;
                            rdfs:subClassOf sec:Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Critical_Vulnerability
sec:Critical_Vulnerability rdf:type owl:Class ;
                           owl:equivalentClass [ owl:intersectionOf ( sec:Vulnerability
                                                                      [ rdf:type owl:Restriction ;
                                                                        owl:onProperty sec:hasCVSSScore ;
                                                                        owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                             owl:onDatatype xsd:decimal ;
                                                                                             owl:withRestrictions ( [ xsd:minExclusive 9.0
                                                                                                                    ]
                                                                                                                  )
                                                                                           ]
                                                                      ]
                                                                    ) ;
                                                 rdf:type owl:Class
                                               ] ;
                           rdfs:subClassOf sec:Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Cyber_Criminal_Group
sec:Cyber_Criminal_Group rdf:type owl:Class ;
                         rdfs:subClassOf sec:Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Financial_Sector
sec:Financial_Sector rdf:type owl:Class ;
                     rdfs:subClassOf sec:Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Goverment_Body
sec:Goverment_Body rdf:type owl:Class ;
                   rdfs:subClassOf sec:Identity .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#High_Impact_Technique
sec:High_Impact_Technique rdf:type owl:Class ;
                          rdfs:subClassOf sec:Attack_Technique .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#High_Risk_Threat_Actor
sec:High_Risk_Threat_Actor rdf:type owl:Class ;
                           rdfs:subClassOf sec:Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#High_Risk_Vulnerability
sec:High_Risk_Vulnerability rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( sec:Vulnerability
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty sec:hasCVSSScore ;
                                                                         owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                              owl:onDatatype xsd:decimal ;
                                                                                              owl:withRestrictions ( [ xsd:minExclusive 7.0
                                                                                                                     ]
                                                                                                                     [ xsd:maxInclusive 9.0
                                                                                                                     ]
                                                                                                                   )
                                                                                            ]
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf sec:Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Identity
sec:Identity rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Insider_Threat
sec:Insider_Threat rdf:type owl:Class ;
                   rdfs:subClassOf sec:Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Malware
sec:Malware rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Medium_Risk_Vulnerability
sec:Medium_Risk_Vulnerability rdf:type owl:Class ;
                              owl:equivalentClass [ owl:intersectionOf ( sec:Vulnerability
                                                                         [ rdf:type owl:Restriction ;
                                                                           owl:onProperty sec:hasCVSSScore ;
                                                                           owl:someValuesFrom [ rdf:type rdfs:Datatype ;
                                                                                                owl:onDatatype xsd:decimal ;
                                                                                                owl:withRestrictions ( [ xsd:minExclusive 4.0
                                                                                                                       ]
                                                                                                                       [ xsd:maxInclusive 7.0
                                                                                                                       ]
                                                                                                                     )
                                                                                              ]
                                                                         ]
                                                                       ) ;
                                                    rdf:type owl:Class
                                                  ] ;
                              rdfs:subClassOf sec:Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Mitigated_Vulnerability
sec:Mitigated_Vulnerability rdf:type owl:Class ;
                            owl:equivalentClass [ owl:intersectionOf ( sec:Vulnerability
                                                                       [ rdf:type owl:Restriction ;
                                                                         owl:onProperty sec:vulnerability_mitigated_course_of_action ;
                                                                         owl:someValuesFrom sec:Course_of_Action
                                                                       ]
                                                                     ) ;
                                                  rdf:type owl:Class
                                                ] ;
                            rdfs:subClassOf sec:Vulnerability .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Ransomware
sec:Ransomware rdf:type owl:Class ;
               rdfs:subClassOf sec:Malware .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Software
sec:Software rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Software_Asset
sec:Software_Asset rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Spyware
sec:Spyware rdf:type owl:Class ;
            rdfs:subClassOf sec:Malware .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#State_Sponsored_Group
sec:State_Sponsored_Group rdf:type owl:Class ;
                          rdfs:subClassOf sec:Threat_Actor .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Threat_Actor
sec:Threat_Actor rdf:type owl:Class .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Trojan_Horse
sec:Trojan_Horse rdf:type owl:Class ;
                 rdfs:subClassOf sec:Malware .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Vulnerability
sec:Vulnerability rdf:type owl:Class ;
                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                    owl:onProperty sec:vulnerability_classified_by_weakness ;
                                    owl:someValuesFrom sec:Weakness
                                  ] ,
                                  [ rdf:type owl:Restriction ;
                                    owl:onProperty sec:vulnerability_affects_software ;
                                    owl:minQualifiedCardinality "1"^^xsd:nonNegativeInteger ;
                                    owl:onClass sec:Software_Asset
                                  ] .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#Weakness
sec:Weakness rdf:type owl:Class .


#################################################################
#    Individuals
#################################################################

###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#AADInternals
sec:AADInternals rdf:type owl:NamedIndividual ,
                          sec:Software ;
                 rdfs:label "AADInternals" .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#ABK
sec:ABK rdf:type owl:NamedIndividual ,
                 sec:Malware ;
        rdfs:label "ABK" .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#ADVSTORESHELL
sec:ADVSTORESHELL rdf:type owl:NamedIndividual ,
                           sec:Malware ;
                  rdfs:label "ADVSTORESHELL" .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#APT1
sec:APT1 rdf:type owl:NamedIndividual ,
                  sec:Threat_Actor ;
         sec:actor_deploys_malware sec:BISCUIT ,
                                   sec:CALENDAR ,
                                   sec:GLOOXMAIL ,
                                   sec:PoisonIvy ,
                                   sec:Seasalt ,
                                   sec:WEBC2 ;
         sec:actor_uses_technique sec:T1007 ,
                                  sec:T1036.005 ,
                                  sec:T1057 ,
                                  sec:T1135 ,
                                  sec:T1550.002 ;
         sec:uses_software sec:Cachedump ,
                           sec:Lslsass ,
                           sec:Mimikatz ,
                           sec:Net ,
                           sec:Pass_The_Hash_Toolkit ,
                           sec:PsExec ,
                           sec:Tasklist ,
                           sec:gsecdump ,
                           sec:ipconfig ,
                           sec:pwdump ,
                           sec:xCmd ;
         sec:hasActorName "APT1" .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#APT18
sec:APT18 rdf:type owl:NamedIndividual ,
                   sec:Threat_Actor ;
          sec:actor_deploys_malware sec:HTTPBrowser ,
                                    sec:Pisloader ,
                                    sec:gh0st_RAT ,
                                    sec:hcdLoader ;
          sec:actor_uses_technique sec:T1078 ,
                                   sec:T1082 ,
                                   sec:T1083 ,
                                   sec:T1133 ;
          sec:uses_software sec:cmd ;
          sec:hasActorName "APT18" .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#APT19
sec:APT19 rdf:type owl:NamedIndividual ,
                   sec:Threat_Actor ;
          sec:actor_deploys_malware sec:Cobalt_Strike ;
          sec:actor_uses_technique sec:T1033 ,
                                   sec:T1082 ,
                                   sec:T1543.003 ;
          sec:uses_software sec:Empire ;
          sec:hasActorName "APT19" .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#APT28
sec:APT28 rdf:type owl:NamedIndividual ,
                   sec:Threat_Actor ;
          sec:actor_deploys_malware sec:ADVSTORESHELL ,
                                    sec:CHOPSTICK ,
                                    sec:CORESHELL ,
                                    sec:Cannon ,
                                    sec:DealersChoice ,
                                    sec:Downdelph ,
                                    sec:Drovorub ,
                                    sec:Fysbis ,
                                    sec:HIDEDRV ,
                                    sec:JHUHUGIT ,
                                    sec:Komplex ,
                                    sec:LAMEHUG ,
                                    sec:LoJax ,
                                    sec:OLDBAIT ,
                                    sec:USBStealer ,
                                    sec:XAgentOSX ,
                                    sec:XTunnel ,
                                    sec:Zebrocy ,
                                    sec:reGeorg ;
          sec:actor_uses_technique sec:T1021.002 ,
                                   sec:T1036.005 ,
                                   sec:T1057 ,
                                   sec:T1078 ,
                                   sec:T1083 ,
                                   sec:T1110.001 ,
                                   sec:T1110.003 ,
                                   sec:T1120 ,
                                   sec:T1133 ,
                                   sec:T1550.002 ;
          sec:uses_software sec:Forfiles ,
                            sec:Koadic ,
                            sec:Mimikatz ,
                            sec:Net ,
                            sec:Responder ,
                            sec:Tor ,
                            sec:Wevtutil ,
                            sec:Winexe ,
                            sec:certutil ,
                            sec:cipher.exe ;
          sec:hasActorName "APT28" ,
                           "Fancy Bear" ;
          sec:hasMotivation "Espionage" .


###  http://www.tfg-ciberseguridad.org/ontologia/tfg_ontologia_ciberseguridad#APT29
sec:APT29 rdf:type owl:NamedIndividual ,
                   sec:Threat_Actor ;
          sec:actor_deploys_malware sec:BoomBox ,
                                    sec:CloudDuke ,
                                    sec:Cobalt_Strike ,
                                    sec:CosmicDuke ,
                                    sec:CozyCar ,
                                    sec:EnvyScout ,
                                    sec:FatDuke ,
                                    sec:FoggyWeb ,
                                    sec:GeminiDuke ,
                                    sec:GoldFinder ,
                                    sec:GoldMax ,
                                    sec:HAMMERTOSS ,
                                    sec:LiteDuke ,
                                    sec:MiniDuke ,
                                    sec:NativeZone ,
                                    sec:OnionDuke ,
                                    sec:POSHSPY ,
                                    sec:PinchDuke ,
